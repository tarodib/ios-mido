diff --git a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
index 3d405aa..59c7fcb 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -25,7 +25,11 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include "drm-uapi/drm_fourcc.h"
+#ifdef __APPLE__
+#include <sys/sysctl.h>
+#else
 #include <sys/sysinfo.h>
+#endif
 
 #include "freedreno_fence.h"
 #include "freedreno_perfetto.h"
@@ -982,9 +986,16 @@ fd_screen_create(int fd,
    if (driQueryOptionb(config->options, "disable_explicit_sync_heuristic"))
       fd_device_disable_explicit_sync_heuristic(dev);
 
+#ifdef __APPLE__
+   uint64_t memsize = 0;
+   size_t memsize_len = sizeof(memsize);
+   sysctlbyname("hw.memsize", &memsize, &memsize_len, NULL, 0);
+   screen->ram_size = memsize;
+#else
    struct sysinfo si;
    sysinfo(&si);
    screen->ram_size = si.totalram;
+#endif
 
    DBG("Pipe Info:");
    DBG(" GPU-id:          %s", fd_dev_name(screen->dev_id));
