+/*
+ * Copy canvas rect (sx,sy)+(w,h) shown at canvas (dx,dy) into the panel,
+ * nearest neighbour: panel pixel p shows canvas pixel p * canvas / panel.
+ */
+void
+AppleCLCD::midoPresentScaled(SweetSurface *s, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	uintptr_t base = s->kernelAddress() + s->offset;
+	uint32_t stepx = (fLogicalW << 16) / fWidth, stepy = (fLogicalH << 16) / fHeight;
+	/*
+	 * backboardd renders the D211 (P3 wide colour) UI in kCVPixelFormatType_30RGBLE_8A
+	 * ('b3a8', 2 planes): plane 0 words are R[29:20] G[19:10] B[9:0], extended range
+	 * 384 = 0.0 .. 895 = 1.0; alpha is in plane 1 (ignored, the result is opaque).
+	 * Copied raw as BGRA, black came out navy and white pale yellow (run #22 lock screen).
+	 */
+	static uint8_t xr10[1024];
+	static bool xr10_ready;
+	bool wide = (s->pixelFormat == 0x62336138u);   /* 'b3a8' */
+	if (wide && !xr10_ready) {
+		for (int v = 0; v < 1024; v++) {
+			int c = ((v - 384) * 255 + 255) / 511;
+			xr10[v] = (uint8_t)(c < 0 ? 0 : c > 255 ? 255 : c);
+		}
+		xr10_ready = true;
+		IOLog("SWEET FB: converting b3a8 (30RGBLE_8A, XR 384..895) surfaces to BGRA\n");
+	}
+	/* panel range whose canvas pixel falls inside [d, d + len) */
+	uint32_t px0 = (uint32_t)(((uint64_t)dx << 16) + stepx - 1) / stepx;
+	uint32_t px1 = (uint32_t)(((uint64_t)(dx + w) << 16) + stepx - 1) / stepx;
+	uint32_t py0 = (uint32_t)(((uint64_t)dy << 16) + stepy - 1) / stepy;
+	uint32_t py1 = (uint32_t)(((uint64_t)(dy + h) << 16) + stepy - 1) / stepy;
+	px1 = MIN(px1, fWidth);
+	py1 = MIN(py1, fHeight);
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)((py * stepy) >> 16) - dy;
+		if (ly < 0 || ly >= h) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + ly) * s->bytesPerRow) + sx;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (uint32_t px = px0; px < px1; px++) {
+			int32_t lx = (int32_t)((px * stepx) >> 16) - dx;
+			if (lx >= 0 && lx < w) {
+				uint32_t v = srow[lx];
+				if (wide) {
+					v = 0xff000000u | (uint32_t)xr10[(v >> 20) & 0x3ff] << 16 |
+					    (uint32_t)xr10[(v >> 10) & 0x3ff] << 8 | xr10[v & 0x3ff];
+				}
+				drow[px] = v;
+			}
+		}
+	}
+}
