+/* State, wait event and frame-pointer backtrace of a switched-out kernel thread. */
+static void
+mido_dump_thread(thread_t t)
+{
+	if (t == NULL || t == current_thread() || !t->machine.kstackptr || !t->kernel_stack) {
+		return;
+	}
+	arm_kernel_saved_state_t *ss = &((thread_kernel_state_t)t->machine.kstackptr)->machine.ss;
+	uint64_t lo = t->kernel_stack, hi = lo + kernel_stack_size, fp = ss->fp;
+	printf("MIDO boot thread: state 0x%x wait %p lr %llx\n", t->state,
+	    (void *)t->wait_event, ss->lr);
+	printf("MIDO bt:");
+	for (int i = 0; i < 16 && fp >= lo && fp + 16 <= hi && !(fp & 7); i++) {
+		const uint64_t *f = (const uint64_t *)fp;
+		printf(" %llx", f[1]);
+		if ((i & 3) == 3) {
+			printf("\n       ");
+		}
+		fp = f[0];
+	}
+	printf("\n");
+}
+
+static void
+mido_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+	static const char *last_stage;
+	const char *stage = mido_boot_stage;
+	bool in_bsd = (strcmp(stage, "bsd_init") == 0);
+	++mido_ticks;
+	/* Quiet once the bootstrap thread has become init: one line a minute. */
+	if (stage != last_stage || (mido_ticks % 12) == 0) {
+		printf("MIDO tick %u: bootstrap at %s\n", mido_ticks, stage);
+	}
+	if (!in_bsd && stage == last_stage && mido_ticks >= 3) {
+		mido_dump_thread(mido_boot_thread);
+	}
+	last_stage = stage;
+	clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(mido_tick_call, deadline);
