+/* Returns true if insn was an LSE atomic and has been emulated (PC advanced). */
+static bool
+mido_emulate_lse(arm_saved_state_t *state, uint32_t insn)
+{
+	unsigned kind, sz, op = 0, bytes;
+	unsigned rs = (insn >> 16) & 31, rn = (insn >> 5) & 31, rt = insn & 31;
