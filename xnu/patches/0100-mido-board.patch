+	/* SWITCH (write byte) EXT_CSD[32] FLUSH_CACHE = 1; harmless with the cache off. */
+	int e = mido_cmd(6, (3u << 24) | (32u << 16) | (1u << 8), MR_R1B, 0, 0, NULL);
