+		s = mido_wait_sts(MS_XFER_DONE, 5000);
+		if (!s || (s & MS_ERR)) {
+			printf("MIDO EMMC: CMD%u: transfer %s (sts 0x%08x)\n", idx,
+			    s ? "error" : "timeout", s);
+			mido_reset_lines();
+			return s ? EIO : ETIMEDOUT;
+		}
+	}
+	mh_wr(M_STS, 0xffffffff);
