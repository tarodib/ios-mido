+/* State, wait event and frame-pointer backtrace of a switched-out kernel thread. */
+static void
+mido_dump_thread(thread_t t)
+{
+	if (t == NULL || t == current_thread() || !t->machine.kstackptr || !t->kernel_stack) {
+		return;
+	}
+	arm_kernel_saved_state_t *ss = &((thread_kernel_state_t)t->machine.kstackptr)->machine.ss;
+	uint64_t lo = t->kernel_stack, hi = lo + kernel_stack_size, fp = ss->fp;
+	printf("MIDO boot thread: state 0x%x wait %p lr %llx\n", t->state,
+	    (void *)t->wait_event, ss->lr);
+	printf("MIDO bt:");
+	for (int i = 0; i < 16 && fp >= lo && fp + 16 <= hi && !(fp & 7); i++) {
+		const uint64_t *f = (const uint64_t *)fp;
+		printf(" %llx", f[1]);
+		if ((i & 3) == 3) {
+			printf("\n       ");
+		}
+		fp = f[0];
+	}
+	printf("\n");
+}
+
+static void
+mido_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
